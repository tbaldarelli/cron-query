# Docker Compose Environment Variables
# Copy this file to .env and customize as needed

# Host port mapping (default: 8080)
HOST_PORT=8080

# Spring profile (dev, prod)
SPRING_PROFILE=dev

# Logging levels
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG

# CORS configuration
CORS_ORIGINS=*

# Custom crontab file path (optional)
# If not set, uses the default test_crontab.txt from the project
# CUSTOM_CRONTAB=/path/to/your/custom_crontab.txt
